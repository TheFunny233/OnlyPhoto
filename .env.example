# App
APP_NAME=OnlyPhoto
APP_URL=http://localhost:8000
APP_DEMO_MODE=true
DATABASE_URL=file:./data/onlyphoto.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=
REGISTRATION_OPEN=true

# Optional: enables the /api/admin/reports maintenance endpoint (leave empty to disable).
MAINTENANCE_TOKEN=

# Website AI: server-only. Never expose to the browser.
AI_MODE=mock
AI_PROTOCOL=chat_completions
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_RETRIES=1
AI_MAX_IMAGE_EDGE=1600
AI_MAX_IMAGE_BYTES=3000000
# Optional provider-specific: send enable_thinking=false for reasoning models (e.g. Qwen3).
AI_DISABLE_THINKING=false

# Explicit live test authorization and cumulative limits for this project run.
RUN_LIVE_AI_TESTS=false
LIVE_TEST_MAX_REQUESTS=12

# Map provider: "amap" (Gaode/高德) when AMAP_JS_KEY is set, otherwise "osm" (Leaflet + OpenStreetMap).
# The database stores WGS84; GCJ-02 conversion for AMap is handled automatically.
MAP_PROVIDER=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# Fallback map settings (used when the provider is osm, or when AMap fails to load).
# Attribution must remain visible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors

# Comma-separated blocklist applied to spot text and comments (empty = disabled).
SENSITIVE_WORDS=

# HTTP port for the Python server (default 8000).
PORT=8000