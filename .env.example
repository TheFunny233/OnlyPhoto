# App
APP_NAME=PhotoMaster
APP_URL=http://localhost:3000
APP_DEMO_MODE=true
DATABASE_URL=file:./data/photomaster.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=
REGISTRATION_OPEN=true

# Optional: enables the /api/admin/reports maintenance endpoint (leave empty to disable).
MAINTENANCE_TOKEN=

# Website AI: server-only. Never prefix with NEXT_PUBLIC_.
AI_MODE=mock
AI_PROTOCOL=chat_completions
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_RETRIES=1
AI_MAX_IMAGE_EDGE=1600
AI_MAX_IMAGE_BYTES=3000000
AI_USER_DAILY_REQUEST_LIMIT=10
# Optional provider-specific: send enable_thinking=false for reasoning models (e.g. Qwen3).
AI_DISABLE_THINKING=false

# Explicit live test authorization and cumulative limits for this project run.
RUN_LIVE_AI_TESTS=false
LIVE_TEST_MAX_REQUESTS=12

# Public non-secret map settings. Attribution must remain visible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors